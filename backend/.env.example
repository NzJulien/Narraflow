# Copy this file to backend/.env and fill in your own key locally.
# NEVER commit backend/.env or paste your real key into chat, code, or
# version control - Fireworks keys grant billed API access.
#
# The key that was shared earlier in this conversation is now exposed
# (chat text can be logged/seen by others) - rotate/revoke it in the
# Fireworks dashboard and generate a fresh one before using any of this.

FIREWORKS_API_KEY=fw_your_key_here

# Flip each agent from "mock" to "fireworks" (or "vllm" for writer, if
# you're self-hosting on AMD Instinct/ROCm) once the key above is set.
DIRECTOR_BACKEND=mock
WRITER_BACKEND=mock
ARTIST_BACKEND=mock
VOICE_BACKEND=mock
CINEMATOGRAPHER_BACKEND=kenburns

# Optional model overrides
FIREWORKS_TEXT_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
FIREWORKS_IMAGE_MODEL=accounts/fireworks/models/flux-1-schnell-fp8
FIREWORKS_AUDIO_MODEL=whisper-v3
FIREWORKS_VIDEO_MODEL=
