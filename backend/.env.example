# Copy to backend/.env and fill in YOUR OWN keys locally.
# Never commit backend/.env, and never paste keys into chat, code or issues.

# --- AssemblyAI (required for live voice) ------------------------------------
# Get a key at https://www.assemblyai.com/dashboard. It stays on the server: the browser only
# ever receives a short-lived, single-use token minted from it.
ASSEMBLYAI_API_KEY=
# Optional
# ASSEMBLYAI_VOICE=              # agent voice id (server default if empty)
# VOICE_MAX_SESSION_SECONDS=1800 # hard cap per voice session (60-10800)
# VOICE_SESSIONS_PER_HOUR=30     # token-minting rate limit per client
# VOICE_MIN_SILENCE_MS=1300      # how long a pause before the agent assumes you finished
# VOICE_MAX_SILENCE_MS=4500
# VOICE_TOOL_EXECUTION_MODE=interactive   # or "hold"

# --- Illustrations ------------------------------------------------------------
# illustrator = built-in offline storybook illustrator (no key, placeholder-quality art)
# fireworks   = real illustrations from a Fireworks-hosted FLUX model (needs the key below)
IMAGE_PROVIDER=illustrator
FIREWORKS_API_KEY=
# FIREWORKS_IMAGE_MODEL=accounts/fireworks/models/flux-1-schnell-fp8
# IMAGE_WORKERS=3

# --- Limits (protect image spend on a public deployment) -----------------------
# MAX_SCENES_PER_STORY=16
# TOOL_CALLS_PER_HOUR=600
# STORIES_PER_HOUR=60

# --- Deployment ----------------------------------------------------------------
# CORS_ORIGINS=https://your-site.example   # default "*" is for local development only
# TRUST_PROXY=true                          # set behind a reverse proxy so rate limits see real client IPs
# NARRAFLOW_DATA_DIR=/data                  # SQLite + generated images + exports (mount a volume here)

# --- Original multi-agent pipeline (classic.html); all default to offline mock -----
DIRECTOR_BACKEND=mock
WRITER_BACKEND=mock
ARTIST_BACKEND=mock
VOICE_BACKEND=mock
NARRATOR_BACKEND=mock
CINEMATOGRAPHER_BACKEND=kenburns
